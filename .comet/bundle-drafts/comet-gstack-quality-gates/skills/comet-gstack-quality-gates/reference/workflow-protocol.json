{
  "schemaVersion": 1,
  "kind": "comet-five-phase-overlay",
  "name": "comet-gstack-quality-gates",
  "goal": "确认当前 OpenSpec 规格和预算后执行 Comet Classic；完整 diff 审查一次，按批准场景验证，网页只读 QA 按需，归档校验当前证据。",
  "nodes": [
    {
      "id": "open",
      "label": "Open",
      "kind": "control",
      "responsibility": "Intake the user request, choose the change shape, and initialize Comet state.",
      "implementation": {
        "skill": "comet-open",
        "operation": "default",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment"
      ],
      "outputSchemas": [
        "comet.intake.v1"
      ],
      "guardrails": [
        {
          "id": "comet-state-created",
          "label": ".comet.yaml exists",
          "validation": "state-transition"
        }
      ],
      "requiredSkillCalls": [],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "design",
      "label": "Design",
      "kind": "producer",
      "responsibility": "Turn the confirmed request into design artifacts and OpenSpec delta context.",
      "implementation": {
        "skill": "comet-design",
        "operation": "default",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment",
        "override"
      ],
      "outputSchemas": [
        "comet.design.v1"
      ],
      "guardrails": [
        {
          "id": "design-artifacts",
          "label": "Design artifacts exist",
          "validation": "artifact-structured"
        }
      ],
      "requiredSkillCalls": [],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "plan",
      "label": "Plan",
      "kind": "producer",
      "responsibility": "Create the executable implementation plan and task contract.",
      "implementation": {
        "skill": "comet-build",
        "operation": "default",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment",
        "override"
      ],
      "outputSchemas": [
        "comet.plan.v1"
      ],
      "guardrails": [
        {
          "id": "plan-artifacts",
          "label": "Plan artifacts exist",
          "validation": "artifact-structured"
        }
      ],
      "requiredSkillCalls": [],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "execute",
      "label": "Execute",
      "kind": "control",
      "responsibility": "Apply the implementation plan through direct coordinator execution.",
      "implementation": {
        "skill": "comet-build",
        "operation": "default",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment"
      ],
      "outputSchemas": [
        "comet.execution-evidence.v1"
      ],
      "guardrails": [
        {
          "id": "build-complete",
          "label": "Build evidence recorded",
          "validation": "semantic"
        }
      ],
      "requiredSkillCalls": [],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "subagent-execute",
      "label": "Subagent Execute",
      "kind": "handoff",
      "responsibility": "Delegate implementation work and require auditable returned evidence.",
      "implementation": {
        "skill": "subagent-driven-development",
        "operation": "default",
        "scope": "handoff",
        "enforcement": "handoff-guarded"
      },
      "operations": [
        "require",
        "augment"
      ],
      "outputSchemas": [
        "comet.handoff.v1"
      ],
      "guardrails": [
        {
          "id": "handoff-evidence",
          "label": "Handoff evidence recorded",
          "validation": "evidence-only"
        }
      ],
      "requiredSkillCalls": [],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "review",
      "label": "Review",
      "kind": "guardrail",
      "responsibility": "Inspect the implementation with review Skills before verification.",
      "optional": true,
      "implementation": {
        "skill": "requesting-code-review",
        "operation": "default",
        "scope": "review",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment",
        "disable"
      ],
      "outputSchemas": [
        "comet.review.v1",
        "gstack.review.current-diff.v1"
      ],
      "guardrails": [
        {
          "id": "review-evidence",
          "label": "Review evidence recorded",
          "validation": "evidence-only"
        }
      ],
      "requiredSkillCalls": [
        {
          "skill": "requesting-code-review",
          "operation": "require",
          "scope": "review",
          "enforcement": "guarded",
          "reason": "对当前完整 diff 和已批准验收场景审查一次；高风险才追加独立第二审。"
        }
      ],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "verify",
      "label": "Verify",
      "kind": "control",
      "responsibility": "Run verification, reconcile branch state, and decide whether completion is valid.",
      "implementation": {
        "skill": "comet-verify",
        "operation": "default",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment"
      ],
      "outputSchemas": [
        "comet.verify.v1",
        "gstack.verify.scoped.v1"
      ],
      "guardrails": [
        {
          "id": "verify-result",
          "label": "Verification result recorded",
          "validation": "evidence-only"
        }
      ],
      "requiredSkillCalls": [
        {
          "skill": "verification-gate",
          "operation": "require",
          "scope": "main",
          "enforcement": "guarded",
          "reason": "按批准场景运行最终验证，复用相同代码和规格摘要的有效证据。"
        }
      ],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "archive",
      "label": "Archive",
      "kind": "control",
      "responsibility": "Archive the OpenSpec change and sync completed deltas back to the main specs.",
      "implementation": {
        "skill": "comet-archive",
        "operation": "default",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment"
      ],
      "outputSchemas": [
        "comet.archive.v1"
      ],
      "guardrails": [
        {
          "id": "archive-state",
          "label": "Archive state recorded",
          "validation": "state-transition"
        }
      ],
      "requiredSkillCalls": [],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    }
  ],
  "edges": [
    {
      "from": "open",
      "to": "design",
      "condition": "success"
    },
    {
      "from": "open",
      "to": "open",
      "condition": "failure"
    },
    {
      "from": "open",
      "to": "open",
      "condition": "pause"
    },
    {
      "from": "design",
      "to": "plan",
      "condition": "success"
    },
    {
      "from": "design",
      "to": "design",
      "condition": "failure"
    },
    {
      "from": "design",
      "to": "design",
      "condition": "pause"
    },
    {
      "from": "plan",
      "to": "execute",
      "condition": "success"
    },
    {
      "from": "plan",
      "to": "plan",
      "condition": "failure"
    },
    {
      "from": "plan",
      "to": "plan",
      "condition": "pause"
    },
    {
      "from": "execute",
      "to": "subagent-execute",
      "condition": "success"
    },
    {
      "from": "execute",
      "to": "execute",
      "condition": "failure"
    },
    {
      "from": "execute",
      "to": "execute",
      "condition": "pause"
    },
    {
      "from": "subagent-execute",
      "to": "review",
      "condition": "success"
    },
    {
      "from": "subagent-execute",
      "to": "subagent-execute",
      "condition": "failure"
    },
    {
      "from": "subagent-execute",
      "to": "subagent-execute",
      "condition": "pause"
    },
    {
      "from": "review",
      "to": "verify",
      "condition": "success"
    },
    {
      "from": "review",
      "to": "review",
      "condition": "failure"
    },
    {
      "from": "review",
      "to": "review",
      "condition": "pause"
    },
    {
      "from": "verify",
      "to": "archive",
      "condition": "success"
    },
    {
      "from": "verify",
      "to": "verify",
      "condition": "failure"
    },
    {
      "from": "verify",
      "to": "verify",
      "condition": "pause"
    },
    {
      "from": "archive",
      "to": null,
      "condition": "success"
    },
    {
      "from": "archive",
      "to": "archive",
      "condition": "failure"
    },
    {
      "from": "archive",
      "to": "archive",
      "condition": "pause"
    }
  ],
  "outputSchemas": [
    {
      "id": "comet.intake.v1",
      "description": "Comet change intake and initial state.",
      "artifacts": [
        {
          "id": "comet-state",
          "kind": "state",
          "required": true,
          "paths": [
            "openspec/changes/*/.comet.yaml"
          ],
          "validations": [
            "state-transition"
          ]
        }
      ],
      "evidence": [
        {
          "id": "intake-summary",
          "required": true
        }
      ]
    },
    {
      "id": "comet.design.v1",
      "description": "Comet design artifacts and OpenSpec delta context.",
      "artifacts": [
        {
          "id": "design-doc",
          "kind": "file",
          "required": true,
          "paths": [
            "docs/superpowers/specs/*.md"
          ],
          "validations": [
            "artifact-exists",
            "artifact-structured"
          ]
        },
        {
          "id": "delta-spec",
          "kind": "file",
          "required": true,
          "paths": [
            "openspec/changes/*/specs/*/spec.md"
          ],
          "validations": [
            "artifact-exists",
            "artifact-structured"
          ]
        }
      ],
      "evidence": [
        {
          "id": "design-summary",
          "required": true
        },
        {
          "id": "user-confirmation",
          "required": true
        }
      ]
    },
    {
      "id": "comet.plan.v1",
      "description": "Comet executable implementation plan.",
      "artifacts": [
        {
          "id": "implementation-plan",
          "kind": "file",
          "required": true,
          "paths": [
            "docs/superpowers/plans/*.md"
          ],
          "validations": [
            "artifact-exists",
            "artifact-structured"
          ]
        },
        {
          "id": "openspec-tasks",
          "kind": "file",
          "required": false,
          "paths": [
            "openspec/changes/*/tasks.md"
          ],
          "validations": [
            "artifact-exists",
            "artifact-structured"
          ]
        }
      ],
      "evidence": [
        {
          "id": "producer-summary",
          "required": true
        }
      ]
    },
    {
      "id": "comet.execution-evidence.v1",
      "description": "Comet build execution evidence and task completion.",
      "artifacts": [
        {
          "id": "task-state",
          "kind": "file",
          "required": true,
          "paths": [
            "openspec/changes/*/tasks.md"
          ],
          "validations": [
            "artifact-structured",
            "semantic"
          ]
        }
      ],
      "evidence": [
        {
          "id": "implementation-summary",
          "required": true
        },
        {
          "id": "test-evidence",
          "required": true
        }
      ]
    },
    {
      "id": "comet.handoff.v1",
      "description": "Subagent handoff request and returned evidence.",
      "artifacts": [],
      "evidence": [
        {
          "id": "handoff-request",
          "required": true
        },
        {
          "id": "handoff-result",
          "required": true
        }
      ]
    },
    {
      "id": "comet.review.v1",
      "description": "Review or whitebox rule report.",
      "artifacts": [],
      "evidence": [
        {
          "id": "review-summary",
          "required": true
        },
        {
          "id": "review-blockers",
          "required": false
        }
      ]
    },
    {
      "id": "comet.verify.v1",
      "description": "Comet verification evidence and branch handling.",
      "artifacts": [],
      "evidence": [
        {
          "id": "verification-commands",
          "required": true
        },
        {
          "id": "verification-result",
          "required": true
        }
      ]
    },
    {
      "id": "comet.archive.v1",
      "description": "OpenSpec archive and delta sync result.",
      "artifacts": [],
      "evidence": [
        {
          "id": "archive-summary",
          "required": true
        },
        {
          "id": "archived-state",
          "required": true
        }
      ]
    },
    {
      "id": "gstack.review.current-diff.v1",
      "description": "当前完整 diff 一次审查，绑定代码与规格摘要。",
      "artifacts": [
        {
          "id": "current-diff-review-report",
          "kind": "report",
          "required": true,
          "paths": [
            "openspec/changes/*/evidence/gstack/review-current-diff.json"
          ],
          "validations": [
            "artifact-exists",
            "artifact-structured",
            "semantic"
          ]
        }
      ],
      "evidence": [
        {
          "id": "review-code-state-hash",
          "required": true
        },
        {
          "id": "review-spec-digest",
          "required": true
        },
        {
          "id": "review-result",
          "required": true
        },
        {
          "id": "review-blockers-resolved",
          "required": true
        }
      ],
      "semanticRules": [
        {
          "id": "review-current-code",
          "operator": "matches-current-code",
          "fields": [
            "review-code-state-hash"
          ],
          "remediation": "review-quality-blocked"
        },
        {
          "id": "review-passed",
          "operator": "equals",
          "field": "review-result",
          "value": "pass",
          "remediation": "review-quality-blocked"
        },
        {
          "id": "review-blockers-resolved",
          "operator": "equals",
          "field": "review-blockers-resolved",
          "value": true,
          "remediation": "review-quality-blocked"
        }
      ]
    },
    {
      "id": "gstack.verify.scoped.v1",
      "description": "按已批准验收场景验证并绑定当前代码与规格。网页任务的只读 QA 由开工预算证据单独记录。",
      "artifacts": [
        {
          "id": "scoped-verify-report",
          "kind": "report",
          "required": true,
          "paths": [
            "openspec/changes/*/evidence/gstack/verify-scoped.json"
          ],
          "validations": [
            "artifact-exists",
            "artifact-structured",
            "semantic"
          ]
        }
      ],
      "evidence": [
        {
          "id": "verification-gate-passed",
          "required": true
        },
        {
          "id": "verification-gate-code-state-hash",
          "required": true
        },
        {
          "id": "verification-gate-draft-hash",
          "required": true
        },
        {
          "id": "verify-evidence-validity",
          "required": true
        }
      ],
      "semanticRules": [
        {
          "id": "verification-gate-must-pass",
          "operator": "equals",
          "field": "verification-gate-passed",
          "value": true
        },
        {
          "id": "verify-current-code",
          "operator": "matches-current-code",
          "fields": [
            "verification-gate-code-state-hash"
          ]
        },
        {
          "id": "verify-current-draft",
          "operator": "matches-protocol",
          "fields": [
            "verification-gate-draft-hash"
          ]
        },
        {
          "id": "verify-evidence-valid",
          "operator": "equals",
          "field": "verify-evidence-validity",
          "value": "valid"
        }
      ]
    }
  ],
  "remediationTransitions": [
    {
      "id": "design-quality-blocked",
      "from": "design",
      "to": "design",
      "overlayEvents": [],
      "onFailure": true,
      "invalidateEvidence": [
        "design"
      ]
    },
    {
      "id": "execute-quality-blocked",
      "from": "execute",
      "to": "execute",
      "overlayEvents": [],
      "onFailure": true,
      "invalidateEvidence": [
        "execute"
      ]
    },
    {
      "id": "subagent-quality-blocked",
      "from": "subagent-execute",
      "to": "subagent-execute",
      "overlayEvents": [],
      "onFailure": true,
      "invalidateEvidence": [
        "subagent-execute"
      ]
    },
    {
      "id": "review-quality-blocked",
      "from": "review",
      "to": "execute",
      "overlayEvents": [],
      "onFailure": true,
      "invalidateEvidence": [
        "execute",
        "subagent-execute",
        "review"
      ]
    },
    {
      "id": "verify-qa-invalidated",
      "from": "verify",
      "to": "execute",
      "overlayEvents": [
        "verify-fail"
      ],
      "onFailure": true,
      "invalidateEvidence": [
        "execute",
        "subagent-execute",
        "review",
        "verify"
      ]
    },
    {
      "id": "archive-quality-blocked",
      "from": "archive",
      "to": "execute",
      "overlayEvents": [
        "archive-reopen",
        "verify-fail"
      ],
      "onFailure": true,
      "invalidateEvidence": [
        "execute",
        "subagent-execute",
        "review",
        "verify",
        "archive"
      ]
    }
  ],
  "state": {
    "kind": "comet-overlay",
    "statePath": "openspec/changes/*/.comet.yaml",
    "currentNodeField": "phase",
    "completedNodesField": "completedNodes",
    "evidenceField": "evidence"
  },
  "evals": [
    {
      "id": "comet-five-phase-contract",
      "expectedNodeOrder": [
        "open",
        "design",
        "plan",
        "execute",
        "subagent-execute",
        "review",
        "verify",
        "archive"
      ],
      "requiredOutputSchemas": [
        "comet.intake.v1",
        "comet.design.v1",
        "comet.plan.v1",
        "comet.execution-evidence.v1",
        "comet.handoff.v1",
        "comet.review.v1",
        "comet.verify.v1",
        "comet.archive.v1",
        "gstack.review.current-diff.v1",
        "gstack.verify.scoped.v1"
      ],
      "scenarios": []
    }
  ]
}
